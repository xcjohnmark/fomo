# Database Configuration
# For production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/fomo_db
# For lightweight local dev/testing: sqlite+aiosqlite:///./fomo_research.db
DATABASE_URL=sqlite+aiosqlite:///./fomo_research.db

# Telegram Configuration
# Leave blank to run in Dry-Run mode (logs alerts to logger instead of network call)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strategy & Scanner Configuration
# Minimum score (0-100) to trigger an alert
MIN_MOMENTUM_SCORE=85
# Minimum liquidity in USD for candidate consideration
MIN_LIQUIDITY_USD=5000
# Target market cap range in USD
MIN_MARKET_CAP_USD=10000
MAX_MARKET_CAP_USD=10000000

# Scanner Settings
SCAN_INTERVAL_SECONDS=10
DRY_RUN=false

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE=logs/fomo_momentum.log
